# Fitness Freak — server environment
# Copy this file to  server/.env  and fill in your own values.
# (server/.env is gitignored — never commit real secrets.)

# --- Database -------------------------------------------------------------
# LOCAL DEV: leave these blank — the app uses a plain SQLite file in
#   server/data/ automatically. (Optionally set DATA_DIR to move that file.)
# PRODUCTION: point at a hosted Turso/libSQL database so a free host works.
#   1. Install the CLI:  https://docs.turso.tech/cli/installation
#   2. turso auth signup
#   3. turso db create fitness-freak
#   4. turso db show fitness-freak --url      -> TURSO_DATABASE_URL
#   5. turso db tokens create fitness-freak   -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# DATA_DIR=./data

# --- Auth -----------------------------------------------------------------
# Signs login tokens. MUST be set to a long random string in production.
# JWT_SECRET=change-me-to-a-long-random-string

# --- Google Health API (Fitbit Air) integration ---------------------------
# Create an app in Google Cloud Console (APIs & Services → Credentials →
# OAuth client ID → "Web application"), enable the Google Health API, and add
# this exact redirect URI to the client's "Authorized redirect URIs":
#   http://localhost:4000/api/integrations/google_health/callback
#
# Then paste the client's ID and secret below.
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=

# Must match the redirect URI registered on the OAuth client (above default is fine for local dev).
GOOGLE_HEALTH_REDIRECT_URI=http://localhost:4000/api/integrations/google_health/callback

# Where the browser is sent back after connecting (your running frontend).
FRONTEND_URL=http://localhost:5173

# Optional: override the token-signing secret (defaults to a dev secret).
# JWT_SECRET=change-me
