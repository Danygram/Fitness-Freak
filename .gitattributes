# Normalize line endings: store text as LF in the repo, check out as-is.
# Silences the Windows "LF will be replaced by CRLF" warnings.
* text=auto eol=lf

# Explicit text types (kept LF even if Git's heuristic is unsure).
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.webmanifest text eol=lf

# Binary assets — never touch these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
